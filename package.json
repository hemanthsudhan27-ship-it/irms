{
  "name": "irms-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "pnpm --filter @irms/backend dev",
    "dev:frontend": "pnpm --filter @irms/frontend dev",
    "build:backend": "pnpm --filter @irms/backend build",
    "build:frontend": "pnpm --filter @irms/frontend build",
    "build": "pnpm --filter @irms/backend build && pnpm --filter @irms/frontend build",
    "lint": "pnpm --filter @irms/frontend lint"
  },
  "devDependencies": {
    "prettier": "^3.5.0"
  }
}
